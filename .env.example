# ==============================================================================
# Hand Cricket Omegle — Production Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Realtime Infrastructure (Ably Pub/Sub — Serverless WebSockets)
# ------------------------------------------------------------------------------
# Get your free API key at https://ably.com
# Required format: <app-id>.<key-id>:<key-secret>
ABLY_API_KEY=your_ably_api_key_here

# ------------------------------------------------------------------------------
# 2. Matchmaking & State Storage (Upstash Redis — Serverless REST)
# ------------------------------------------------------------------------------
# Provision a free serverless Redis database at https://upstash.com
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# ------------------------------------------------------------------------------
# 3. WebRTC TURN / STUN Ephemeral Traversal (SEC-01)
# ------------------------------------------------------------------------------
# Ephemeral TURN credentials generated server-side via POST /api/ice.
# NEVER prefix with NEXT_PUBLIC_* to prevent client-side credential extraction.
#
# Option A: Metered.ca (Free 50GB/month managed TURN)
# Get credentials at https://www.metered.ca
METERED_API_KEY=your_metered_api_key_here
METERED_APP_NAME=your_metered_app_name_here
#
# Option B: Twilio Network Traversal Service
# Get Account SID and Auth Token at https://www.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
#
# Option C: HMAC Ephemeral TURN (Coturn / Cloudflare Calls / Xirsys)
TURN_SECRET=your_turn_hmac_secret_key_here
TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp

# ------------------------------------------------------------------------------
# 4. Moderation & Admin Dashboard Security (SEC-02)
# ------------------------------------------------------------------------------
# Bearer token required for administrator report actions on /api/admin/reports
ADMIN_SECRET_TOKEN=your_secure_admin_bearer_secret_here

# ------------------------------------------------------------------------------
# 5. Database & Audit Storage (Supabase PostgreSQL / RLS) [Optional]
# ------------------------------------------------------------------------------
# Supabase project URL and keys for persistent user/report storage with RLS policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_private_key_here

# ------------------------------------------------------------------------------
# 6. Canonical Application URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
