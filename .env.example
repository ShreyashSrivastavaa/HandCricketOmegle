# ==============================================================================
# Hand Cricket Live Environment Configuration
# ==============================================================================

# Ably Realtime Pub/Sub Key (Get one free at https://ably.com)
# Format: <app-id>.<key-id>:<key-secret>
ABLY_API_KEY=your_ably_api_key_here

# Upstash Redis REST Credentials (Get free database at https://upstash.com)
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# App Canonical URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
